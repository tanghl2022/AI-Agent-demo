# 模型服务配置；本文件只保存占位值。
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-with-your-key
LLM_MODEL=gpt-4o-mini
CORS_ORIGINS=http://localhost:5173

# checkpoint 必须配置；审计未单独配置时复用数据库地址，但使用独立连接池。
CHECKPOINT_DB_URI=postgresql://postgres:postgres@localhost:5432/agent
AUDIT_DB_URI=
WMS_SERVICE_BASE_URL=http://127.0.0.1:8080
WMS_SERVICE_TIMEOUT=10

# 库存分析工具来源；固定库存/库位查询节点及冻结流程仍使用原 WMS HTTP 适配器。
INVENTORY_TOOL_SOURCE=local
MCP_SERVER_URL=http://127.0.0.1:8001/mcp
MCP_TIMEOUT=15
# 仅连接有鉴权的 MCP 入口时填写；不进入模型或工具参数。
MCP_ACCESS_TOKEN=
